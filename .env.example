# Voltage: every environment variable the backend reads, with a safe default or blank.
# Copy to `.env` next to docker-compose.yml (chmod 600), or to `backend/.env` for a local run.
# A blank value means "not set": the app uses its default (shown in the comment).
# backend/tests/launch/test_env_example.py fails when the backend reads a variable missing here.

# ---- Storage ----------------------------------------------------------------
# Where ave.db and artifacts/ live; left commented, never blank. Compose sets /data (the `avedata` volume); default backend/var.
# AVE_DATA_DIR=/data
# Postgres instead of SQLite, once supported (postgresql://voltage:PASSWORD@postgres:5432/voltage). Blank = SQLite in AVE_DATA_DIR.
DATABASE_URL=
# Compose only: the bundled Postgres service's database, user and password (not read by the app).
POSTGRES_DB=voltage
POSTGRES_USER=voltage
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- Compose and HTTPS (read by docker compose, not the app) -----------------
# `https` adds Caddy on :80/:443 with a Let's Encrypt certificate (the VM). Blank = no Caddy (local).
COMPOSE_PROFILES=https
# The domain Caddy serves and gets a certificate for (its DNS A record points at the VM).
VOLTAGE_DOMAIN=voltage.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=ops@example.com

# ---- Public address and sign-in ----------------------------------------------
# The origin people open the app at; OAuth redirects, share links and emails use it. Default http://localhost:5173.
AVE_PUBLIC_URL=https://voltage.example.com
# Sign-in: off (one local owner) or google. Use google for anything public.
AVE_AUTH=google
# Google OAuth web client (Cloud Console); register {AVE_PUBLIC_URL}/api/auth/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie: a long random string (openssl rand -hex 32). Required with AVE_AUTH=google.
AVE_SESSION_SECRET=
# Signs share links; blank = one is generated into the data dir (share_secret) on first start.
AVE_SHARE_SECRET=
# Who may sign in: emails or @domains, comma-separated. Blank = anyone with a Google account.
AVE_ALLOWED_EMAILS=
# Owners every phase flag is on for by default, comma-separated. Default local.
AVE_FLAG_OWNERS=local
# Owners who see the internal admin page (#admin), comma-separated. Default local.
# An entry with "@" (e.g. founder@yourdomain.com) names a person by address: it matches
# a verified password account, or a Google or emailed-link sign-in, with that address.
AVE_ADMIN_OWNERS=local

# ---- Vendors -------------------------------------------------------------------
# OpenAI: transcription (whisper-1) and diarization. Blank = the offline mock.
OPENAI_API_KEY=
# ElevenLabs: speech, cloning, Voice Changer. Blank = the offline mock.
ELEVENLABS_API_KEY=
# ElevenLabs model. Default eleven_multilingual_v2.
ELEVENLABS_MODEL=eleven_multilingual_v2
# ElevenLabs premade voice for new lines when no clone exists. Default EXAVITQu4vr4xnSDxMaL (Sarah).
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Anthropic: the agent and free-form requests. Blank = the offline mock planner.
ANTHROPIC_API_KEY=
# Needed when the Anthropic key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# 1 = never call a paid vendor, whatever keys exist. Default off.
AVE_DRY_RUN=

# ---- Money ceilings ---------------------------------------------------------------
# Per-project ceiling on billed ElevenLabs characters. Default 2000.
AVE_VOICE_BUDGET_CHARS=2000
# Per-project ceiling on estimated spend across all vendors, USD. Default 2.00.
AVE_PROJECT_BUDGET_USD=2.00
# Per-person ceiling across all their projects, USD. Default 10.00.
AVE_USER_BUDGET_USD=10.00
# ElevenLabs rate used for cost estimates, USD per 1k characters. Default 0.30.
AVE_ELEVENLABS_USD_PER_1K=0.30
# Money cap for one agent turn, USD. Default 0.50.
AVE_AGENT_TURN_USD=0.50

# ---- Voicing and fit -------------------------------------------------------------
# Extra paid takes when a take fails continuity. Default 2.
AVE_MAX_REGENERATIONS=2
# Takes voiced when the first misses its slot; the nearest is kept. Default 3.
AVE_TAKES_PER_LINE=3
# How far off the slot counts as a miss (fraction). Default 0.05.
AVE_FIT_TOLERANCE=0.05
# Takes are voiced one at a time and the first within the tolerance ends the search; this widens it (0: off). Default 0.
AVE_TAKE_ACCEPT=0
# How far the picture may slow or speed so a take fits (1.0 = never). Default 1.12.
AVE_MAX_FLEX=1.12
# How far a pause may stretch for an added line. Default 1.6.
AVE_MAX_LIVING=1.6
# How in-between frames are made: minterpolate, none or rife. Default minterpolate.
AVE_INTERPOLATOR=minterpolate
# Path to the fit rungs table; left commented, never blank. Default backend/bench/rungs.json.
# AVE_RUNGS=/srv/backend/bench/rungs.json
# Clone each speaker's voice (0 = stock voices only). Default 1.
AVE_CLONE=1
# Seconds of a speaker's own speech needed to clone them. Default 10.
AVE_CLONE_MIN_SECONDS=10
# How a take reaches the clone: tts, changer or auto. Default auto.
AVE_VOICE_ROUTE=auto
# Keep music and room under an edited line (needs the optional `room` extra). Default 1.
AVE_STEMS=1
# 0 = skip the SIM-o / UTMOS measures (they need the optional `measure` extra). Default on.
AVE_MEASURE=

# ---- The agent -----------------------------------------------------------------------
# Voltage as an agent with tools (needs an Anthropic key). Default 1.
AVE_AGENT=1
# The agent's model. Default claude-opus-5-5.
AVE_AGENT_MODEL=claude-opus-5-5
# The agent's effort. Default high.
AVE_AGENT_EFFORT=high
# The project check's and learned style's cheap text model. Default claude-haiku-5-5.
AVE_CHECK_MODEL=claude-haiku-5-5
# A turn that only asks how the app works runs on this model, read-only tools (empty: off). Default claude-haiku-5-5.
AVE_QUESTION_MODEL=claude-haiku-5-5
# The grader for `python -m app.tools.agent_eval` only. Default claude-opus-5-5.
AVE_EVAL_GRADER=claude-opus-5-5

# ---- Email and notifications ----------------------------------------------------------
# Who sends email: outbox (nothing leaves the machine; rows in notify_outbox). Default outbox.
# outbox (nothing leaves the machine) or resend. Production refuses outbox.
AVE_EMAIL_PROVIDER=outbox
# Where the local owner's review digest goes while sign-in is off.
AVE_NOTIFY_OWNER_EMAIL=
# Trust and safety inbox for abuse reports. Default trust@voltage.invalid.
AVE_TRUST_EMAIL=trust@voltage.invalid

# ---- The launch rehearsal only (deploy/rehearsal; refused in production) -----------------
# Every vendor, Claude included, is an offline stand-in that waits and bills like the real one.
AVE_MOCK_VENDORS=
# Seconds each stand-in waits, as "low-high": Claude calls (1-3), a voiced line (2-6), a render (5-20).
AVE_MOCK_CLAUDE_SECONDS=
AVE_MOCK_SYNTH_SECONDS=
AVE_MOCK_RENDER_SECONDS=
# The cost evals only (backend/evals): a JSON file of clips whose words are known, read by the mock transcriber.
AVE_KNOWN_TRANSCRIPTS=

# ---- Capacity (one API process; LOAD.md) ------------------------------------------------
# Turns, upload processing and voicing that run at once (the job runner). Default 16.
AVE_JOB_WORKERS=
# Renders and retries started from the editor that run at once. Default 4 (about one per vCPU: renders are ffmpeg).
AVE_WORK_WORKERS=
# Plain (sync) requests served at once, renders on Add included. Default 100.
AVE_HTTP_THREADS=

# Past this share of the data disk used (or under 1 GB free), new uploads and renders are refused
# with a sentence until space is freed. Default 95.
AVE_DISK_FULL_PCT=

# ---- Maintenance (the worker) ---------------------------------------------------------
# Run the Bin purge once a day. Compose sets it on the worker only; leave the API's off.
AVE_PURGE_DAILY=
# The worker sends review digests instead of the API (the API stops sending them when this is on).
AVE_WORKER_DIGESTS=
# Run a second API process on the same database anyway (off: the second refuses to start, because
# rate limits, the spend pause and jobs live in one process's memory). Only after moving those to Redis.
AVE_ALLOW_SECOND_API=
# Years a purged item's consent record is kept. Default 7.
AVE_CONSENT_RETENTION_YEARS=7

# ---- Errors and billing ----------------------------------------------------------------
# Sentry DSN (https://<key>@<host>/<project>). Errors are sent there when set (item 7).
SENTRY_DSN=
# Invoice seller details (placeholders until the business is set up).
AVE_SELLER_NAME=
AVE_SELLER_GSTIN=
# GST state code of the seller. Default 29.
AVE_SELLER_STATE=29

# ---- Media tools -------------------------------------------------------------------------
# ffmpeg and ffprobe binaries. Default ffmpeg / ffprobe on PATH (the image installs them).
AVE_FFMPEG_BIN=ffmpeg
AVE_FFPROBE_BIN=ffprobe

# ---- Game days only --------------------------------------------------------------------
# Faults to inject at the vendor seams (app/chaos.py). Leave blank in production.
AVE_CHAOS=
# Allow AVE_CHAOS with sign-in on. Leave blank in production.
AVE_CHAOS_FORCE=

# ---- Launch hardening (2026-10-22) -------------------------------------------------------
# production makes the server refuse to start without its secrets and never read backend/.env.
AVE_ENV=
# Origins allowed to call the API with cookies (comma-separated). Default AVE_PUBLIC_URL.
AVE_CORS_ORIGINS=
# Upload limits for a video: minutes as seconds, and size in MB. Defaults 600 and 2048.
AVE_MAX_UPLOAD_SECONDS=600
AVE_MAX_UPLOAD_MB=2048
# Everyone's spend in a UTC day before new paid work pauses on its own. Default 50; none to turn off.
AVE_DAILY_SPEND_CAP_USD=50
# Free credits a new account starts with. Default 5 (prices live in backend/app/billing/prices.py).
AVE_TRIAL_CREDITS=5
# Rate limits per bucket, as hits/seconds (turns, synth, uploads, imports, auth, comments, abuse). Blank keeps the defaults.
AVE_RATE_TURNS=
AVE_RATE_SYNTH=
AVE_RATE_UPLOADS=
AVE_RATE_IMPORTS=
AVE_RATE_AUTH=
AVE_RATE_COMMENTS=
AVE_RATE_ABUSE=
# Invite-only sign-up codes, comma-separated (with launch.invite_only on).
AVE_INVITE_CODES=
# The Terms version a sign-up accepts. Default draft-2026-10-22; bump it when the lawyer's text lands.
AVE_TERMS_VERSION=
# Send the master's English to the voice vendor as context for language versions (default off).
AVE_LANG_MASTER_CONTEXT=
# Email through Resend (AVE_EMAIL_PROVIDER=resend): the API key and a verified sender.
AVE_EMAIL_API_KEY=
RESEND_API_KEY=
AVE_EMAIL_FROM=
# Stripe (USD). Real only with both set; otherwise test mode.
AVE_STRIPE_SECRET_KEY=
AVE_STRIPE_WEBHOOK_SECRET=
# Razorpay (INR). Real with the key id and secret; the webhook secret turns the webhook on.
AVE_RAZORPAY_KEY_ID=
AVE_RAZORPAY_KEY_SECRET=
AVE_RAZORPAY_WEBHOOK_SECRET=
# public turns the launch's features on for everyone (backend/app/flags.py PROFILES). Blank: only AVE_FLAG_OWNERS get them.
AVE_LAUNCH_PROFILE=
