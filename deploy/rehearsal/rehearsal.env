# The launch rehearsal on one machine (rehearsal item 2). Not for a real
# deployment: the secrets below are public, every vendor is a stand-in.
#   docker compose -f docker-compose.yml -f deploy/rehearsal/compose.yml up -d --build
AVE_LAUNCH_PROFILE=public
AVE_AUTH=accounts
AVE_PUBLIC_URL=http://localhost:8080
AVE_CORS_ORIGINS=http://localhost:8080
AVE_SESSION_SECRET=rehearsal-only-session-secret-0123456789abcdef
AVE_SHARE_SECRET=rehearsal-only-share-secret-0123456789abcdefgh
AVE_FLAG_OWNERS=
AVE_ADMIN_OWNERS=admin@rehearsal.test
AVE_TRUST_EMAIL=trust@rehearsal.test
# Every vendor offline, timed like the real ones.
AVE_MOCK_VENDORS=1
AVE_MOCK_CLAUDE_SECONDS=1-3
AVE_MOCK_SYNTH_SECONDS=2-6
AVE_MOCK_RENDER_SECONDS=5-20
# The rehearsal's own rate limits stay as shipped; the load test sets its own.
POSTGRES_PASSWORD=rehearsal
DATABASE_URL=postgresql://voltage:rehearsal@postgres:5432/voltage
